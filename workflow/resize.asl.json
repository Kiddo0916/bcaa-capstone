{
  "StartAt": "ResizeImage",
  "States": {
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-2:148142121599:function:bcaa-capstone-resize-image",
        "Payload.$": "$"
      },
      "Next": "CheckResult",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "ResizeFailed"
        }
      ]
    },
    "CheckResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Payload.success",
          "BooleanEquals": true,
          "Next": "ResizeSucceeded"
        }
      ],
      "Default": "ResizeFailed"
    },
    "ResizeSucceeded": {
      "Type": "Succeed",
      "OutputPath": "$.Payload"
    },
    "ResizeFailed": {
      "Type": "Fail",
      "Error": "ImageResizeFailed"
    }
  }
}